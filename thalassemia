        tinh_ds_o = TAT_CA_TINH if ss.vung_o == "Chọn vùng/miền" else ["Chọn Tỉnh/Thành phố"] + TINH_THEO_VUNG.get(ss.vung_o, [])
        ss.tinh_o = st.selectbox("Tỉnh/Thành phố:", tinh_ds_o, index=tinh_ds_o.index(ss.tinh_o) if ss.tinh_o in tinh_ds_o else 0)
        ss.do_cao = st.selectbox("🏔️ Độ cao sinh sống (WHO 2024):", ALTITUDE_OPTIONS, index=ALTITUDE_OPTIONS.index(ss.do_cao) if ss.do_cao in ALTITUDE_OPTIONS else 0)

    st.markdown("---")
    t1, t2, t3 = st.tabs(["VÒNG 1: Tiền sử & Dịch tễ", "VÒNG 2: Công thức máu", "VÒNG 3: Điện di Hb & Gen"])

    with t1:
        score_v1 = DIEM_DAN_TOC_VN.get(ss.dantoc, 0.5)
        for idx, q_text in enumerate(CAU_HOI, 1):
            col_q, col_a = st.columns([3.5, 1])
            with col_q: st.write(q_text)
            with col_a:
                ans = st.radio(f"q_{idx}", ["Có", "Không"], key=f"q{idx}", horizontal=True, label_visibility="collapsed")
                if ans == "Có": score_v1 += 1.0
        ss.s1 = score_v1
        if st.button("💾 Lưu vĩnh viễn Vòng 1", key="btn_v1"):
            if luu_thong_tin_khach_hang(vong=1): st.success(f"Đã lưu thành công vào Database! Điểm V1: {ss.s1}")

    with t2:
        cmcv, cmch, chb, crbc, crdw = st.columns(5)
        with cmcv: ss.mcv = st.number_input("MCV (fL):", value=ss.mcv, min_value=0.0, step=0.1)
        with cmch: ss.mch = st.number_input("MCH (pg):", value=ss.mch, min_value=0.0, step=0.1)
        with chb: ss.hb = st.number_input("Hemoglobin (g/dL):", value=ss.hb, min_value=0.0, step=0.1)
        with crbc: ss.rbc = st.number_input("RBC (M/uL):", value=ss.rbc, min_value=0.0, step=0.01)
        with crdw: ss.rdw = st.number_input("RDW (%):", value=ss.rdw, min_value=0.0, step=0.1)

        s2_score, _, hb_hieuchinh = score_round2(ss.mcv, ss.mch, ss.hb, ss.rbc, ss.rdw, ss.gioitinh, ss.do_cao)
        ss.s2 = s2_score
        if ss.hb > 0: st.info(f"⚙️ Hb hiệu chỉnh theo độ cao: **{hb_hieuchinh:.2f} g/dL**")
        if st.button("💾 Lưu vĩnh viễn Vòng 2", key="btn_v2"):
            if luu_thong_tin_khach_hang(vong=2): st.success(f"Đã lưu Vòng 2 thành công vào Database! Điểm V2: {ss.s2}")

    with t3:
        ca, ca2, cf = st.columns(3)
        with ca: ss.hba = st.number_input("HbA (%):", value=ss.hba, min_value=0.0, max_value=100.0)
        with ca2: ss.hba2 = st.number_input("HbA2 (%):", value=ss.hba2, min_value=0.0, max_value=100.0)
        with cf: ss.hbf = st.number_input("HbF (%):", value=ss.hbf, min_value=0.0, max_value=100.0)
        ss.ketluan_r3 = st.text_area("Kết luận Vòng 3 / Gen:", value=ss.ketluan_r3)
        if st.button("💾 Lưu vĩnh viễn Vòng 3", key="btn_v3"):
            if luu_thong_tin_khach_hang(vong=3): st.success("Đã lưu Vòng 3 thành công!")

if __name__ == "__main__":
    main()
