def luu_thong_tin_khach_hang(vong=None):
    ss = st.session_state
    ho_ten = str(ss.get("hoten", "")).strip()
    if not ho_ten:
        st.warning("Vui lòng nhập Họ tên trước khi lưu!")
        return False

    if not ss.get("ho_so_id"): ss.ho_so_id = uuid.uuid4().hex
    if vong == 1: ss.vong1_da_luu = True
    elif vong == 2: ss.vong2_da_luu = True
    elif vong == 3: ss.vong3_da_luu = True

    cau_tra_loi_v1 = [{"stt": i, "cau_hoi": CAU_HOI[i - 1], "tra_loi": ss.get(f"q{i}", "Không")} for i in range(1, 16)]

    record = {
        "id": ss.ho_so_id,
        "ho_ten": ho_ten,
        "gioi_tinh": ss.get("gioitinh", "Nữ"),
        "ngay_sinh": str(ss.get("ngaysinh")),
        "dan_toc": ss.get("dantoc", ""),
        "sdt": str(ss.get("sdt", "")).strip(),
        "tinh_o": ss.get("tinh_o", ""),
        "vung_o": ss.get("vung_o", ""),
        "tinh_lam_viec": ss.get("tinh_lamviec", ""),
        "vung_lam_viec": ss.get("vung_lamviec", ""),
        "nghe_nghiep": ss.get("nghenghiep", ""),
        "do_cao": ss.get("do_cao", ALTITUDE_OPTIONS[0]),
        "diem_v1": ss.get("s1", 0.0) if ss.vong1_da_luu else None,
        "ket_luan_v1": classify_round1(ss.get("s1", 0.0))[0] if ss.vong1_da_luu else "",
        "diem_v2": ss.get("s2", 0) if ss.vong2_da_luu else None,
        "ket_luan_tong": classify_total(ss.get("s1", 0.0), ss.get("s2", 0))[0] if ss.vong2_da_luu else "",
        "mcv": ss.get("mcv", 0.0), "mch": ss.get("mch", 0.0), "hb": ss.get("hb", 0.0),
        "rbc": ss.get("rbc", 0.0), "rdw": ss.get("rdw", 0.0),
        "hba": ss.get("hba", 0.0), "hba2": ss.get("hba2", 0.0), "hbf": ss.get("hbf", 0.0),
        "ket_luan_v3": ss.get("ketluan_r3", ""),
        "chi_tiet_v1_json": json.dumps(cau_tra_loi_v1, ensure_ascii=False),
        "updated_at": datetime.now().isoformat()
    }

    if supabase_client:
        return ghi_database_supabase(record)
    else:
        st.info("⚠️ Chưa cấu hình Supabase Secrets. Dữ liệu chỉ được giữ tạm thời.")
        return True

