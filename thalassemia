def lay_benh_vien_theo_tinh(tinh_tru):
    if not tinh_tru or tinh_tru == "Chọn Tỉnh/Thành phố":
        return []
    if tinh_tru in BENH_VIEN:
        return BENH_VIEN[tinh_tru]
    vung_tru = VUNG_CUA_TINH.get(tinh_tru, "")
    ds = []
    for tinh, lst in BENH_VIEN.items():
        if VUNG_CUA_TINH.get(tinh, "") == vung_tru:
            ds.extend(lst)
    return ds

def classify_round1(s1):
    if s1 <= 5: return ("Nguy cơ thấp", "Theo dõi sức khỏe định kỳ. Chưa cần làm công thức máu ngay.")
    if s1 <= 12: return ("Nguy cơ trung bình", "Khuyến nghị làm công thức máu (CBC) tại cơ sở y tế gần nhất.")
    return ("Nguy cơ cao", "Cần làm công thức máu và thực hiện xét nghiệm chuyên sâu Vòng 2 & 3.")

def classify_total(s1, s2):
    total = s1 + s2
    if total >= 15: return ("Nguy cơ RẤT CAO", "Gửi mẫu điện di huyết sắc tố / Xét nghiệm gen ngay.")
    if total >= 10 or s2 >= 4: return ("Nguy cơ CAO", "Thực hiện điện di huyết sắc tố. Tư vấn di truyền chi tiết.")
    if total >= 6: return ("Nguy cơ TRUNG BÌNH", "Theo dõi, kiểm tra công thức máu lại sau 6 tháng.")
    return "Nguy cơ THẤP", "Tư vấn sức khỏe sinh sản / theo dõi định kỳ."

def score_round2(mcv, mch, hb_tho, rbc, rdw, gioitinh, do_cao_option):
    giam_hb = ALTITUDE_CORRECTION_MAP.get(do_cao_option, 0.0)
    hb_hieuchinh = hb_tho - giam_hb
    hb_cut = 12.0 if gioitinh == "Nữ" else 13.0
    score_mcv = 4 if (0 < mcv < 86.0) else 0
    score_mch = 3 if (0 < mch < 27.0) else 0
    score_hb = 2 if (0 < hb_hieuchinh < hb_cut) else 0
    score_rbc = 2 if rbc >= 5.0 else 0
    score_rdw = 2 if (11.0 <= rdw <= 15.0 and 0 < mcv < 86.0) else 0
    
    rows = [
        ("MCV", f"{mcv:.2f} fL", "86.0 – 98.0 fL", score_mcv),
        ("MCH", f"{mch:.2f} pg", "27.0 – 32.0 pg", score_mch),
        ("Hemoglobin", f"{hb_hieuchinh:.2f} g/dL", f"< {hb_cut:.1f} g/dL ({gioitinh})", score_hb),
        ("RBC", f"{rbc:.2f} M/uL", "4.30 – 5.80 M/uL", score_rbc),
        ("RDW", f"{rdw:.2f} %", "11.0 – 15.0 %", score_rdw)
    ]
    return sum(r[3] for r in rows), rows, hb_hieuchinh

def ghi_database_supabase(record_data):
    if not supabase_client:
        return False
    try:
        supabase_client.table("ho_so_thalassemia").upsert(record_data).execute()
        return True
    except Exception as e:
        st.error(f"Lỗi lưu cơ sở dữ liệu Supabase: {e}")
        return False

def doc_database_supabase():
    if not supabase_client:
        return []
    try:
        res = supabase_client.table("ho_so_thalassemia").select("*").order("created_at", desc=True).execute()
        return res.data
    except Exception as e:
        st.error(f"Lỗi đọc dữ liệu Supabase: {e}")
        return []

